<style>
#kc .calc{background:var(--g);color:var(--lin);padding:clamp(72px,7vw,128px) 0}
#kc .calc .kick{color:var(--go)}
#kc .calc .ch{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(40px,5vw,110px);align-items:start}
#kc .calc h2{margin:16px 0 18px;color:var(--lin)}
#kc .calc .lead{max-width:34em;color:rgba(243,238,230,.74);margin-bottom:clamp(30px,3vw,48px)}
#kc .calc .ai{margin-bottom:22px}
#kc .calc .ai-in{display:block;padding:18px 20px 14px;border:1px solid rgba(201,169,110,.55);background:rgba(243,238,230,.04);cursor:text}
#kc .calc .ai-in:focus-within{border-color:var(--go);background:rgba(243,238,230,.07)}
#kc .calc .ai-k{display:flex;align-items:center;gap:10px;font:500 11px/1.4 var(--sans);letter-spacing:.24em;text-transform:uppercase;color:var(--go)}
#kc .calc .ai-k svg{width:16px;height:16px;fill:var(--go);stroke:none;margin:0;animation:kcsp 3.2s ease-in-out infinite}
@keyframes kcsp{0%,100%{opacity:.55;transform:scale(.92)}50%{opacity:1;transform:scale(1.06)}}
#kc .calc textarea{display:block;overflow:hidden;min-height:2.7em;width:100%;margin-top:10px;border:0;outline:0;resize:none;background:transparent;color:var(--lin);font:300 clamp(20px,1.7vw,26px)/1.35 var(--serif)}
#kc .calc textarea::placeholder{color:rgba(243,238,230,.38)}
#kc .calc .ai-out{display:flex;flex-wrap:wrap;gap:8px;min-height:0;margin-top:12px}
#kc .calc .ai-out span{padding:7px 12px;border:1px solid rgba(201,169,110,.45);font:500 11px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--lin);animation:kcin .4s cubic-bezier(.2,.7,.2,1) both}
#kc .calc .ai-out span.q{border-style:dashed;color:rgba(243,238,230,.6)}
@keyframes kcin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
#kc .calc .ai-in{position:relative}
#kc .calc .ai-go{display:flex;justify-content:flex-end;margin-top:10px}
#kc .calc .ai-go .bt{height:46px;padding:0 22px;background:var(--go);color:var(--g)}
#kc .calc .ai-go .bt:hover{background:var(--lin)}
#kc .calc .ai-ex{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:14px}
#kc .calc .ai-ex span{font:500 10.5px/1 var(--sans);letter-spacing:.24em;text-transform:uppercase;color:rgba(243,238,230,.45);margin-right:4px}
#kc .calc .ai-ex button{border:1px solid rgba(243,238,230,.22);background:transparent;color:rgba(243,238,230,.82);padding:9px 13px;font:400 13px/1.2 var(--sans);cursor:pointer;transition:.2s}
#kc .calc .ai-ex button:hover{border-color:var(--go);color:var(--lin)}
#kc .calc .ai-skip{display:inline-block;margin-top:16px;border:0;background:none;padding:0;color:rgba(243,238,230,.6);font:500 11px/1.4 var(--sans);letter-spacing:.2em;text-transform:uppercase;text-decoration:underline;text-underline-offset:5px;cursor:pointer}
#kc .calc .ai-skip:hover{color:var(--lin)}
#kc .calc.s1 .pk,#kc .calc.s1 .res .full,#kc .calc.s2 .res .ph,#kc .calc.s2 .ai-ex,#kc .calc.s2 .ai-skip,#kc .calc.s2 .ai-go{display:none}
#kc .calc.s2 .pk{animation:kcup .6s cubic-bezier(.2,.7,.2,1) both}
#kc .calc.s2 .res .full{animation:kcin .5s cubic-bezier(.2,.7,.2,1) both}
@keyframes kcup{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
#kc .calc .ph .pr{color:rgba(27,35,33,.22)}
#kc .calc .ph p{font-size:14px;color:var(--mut);margin:6px 0 22px;max-width:30em}
#kc .calc .ai-note{width:100%;font-size:13px;color:rgba(243,238,230,.7);margin-top:2px}
#kc .calc .or{display:flex;align-items:center;gap:16px;margin:0 0 22px;font:500 10.5px/1 var(--sans);letter-spacing:.28em;text-transform:uppercase;color:rgba(243,238,230,.4)}
#kc .calc .or:before,#kc .calc .or:after{content:"";flex:1;height:1px;background:rgba(243,238,230,.14)}
#kc .calc .tip{display:flex;gap:10px;margin-top:12px;padding:12px 14px;background:var(--lin2);font-size:13px;line-height:1.5;color:var(--ink)}
#kc .calc .tip:before{content:"";flex:0 0 7px;height:7px;margin-top:6px;background:var(--go);transform:rotate(45deg)}
#kc .calc .tip:empty{display:none}
#kc .calc label.hit{animation:kchit .9s ease}
@keyframes kchit{0%{box-shadow:0 0 0 0 rgba(201,169,110,.7)}100%{box-shadow:0 0 0 10px rgba(201,169,110,0)}}
#kc .calc fieldset{border:0;padding:0;margin:0 0 clamp(24px,2.4vw,34px)}
#kc .calc legend{display:flex;align-items:baseline;gap:14px;font:500 11px/1.4 var(--sans);letter-spacing:.28em;text-transform:uppercase;color:rgba(243,238,230,.66);margin-bottom:14px}
#kc .calc legend i{font:300 22px/1 var(--serif);font-style:normal;letter-spacing:0;color:var(--go)}
#kc .calc .op{display:grid;gap:10px}
#kc .calc .op4{grid-template-columns:repeat(4,minmax(0,1fr))}
#kc .calc .op3{grid-template-columns:repeat(3,minmax(0,1fr))}
#kc .calc .op2{grid-template-columns:repeat(2,minmax(0,1fr))}
#kc .calc .op5{grid-template-columns:repeat(5,minmax(0,1fr))}
#kc .calc .op6{grid-template-columns:repeat(6,minmax(0,1fr))}
#kc .calc label{position:relative;display:flex;flex-direction:column;gap:6px;min-height:100%;padding:16px 16px 15px;border:1px solid rgba(243,238,230,.18);cursor:pointer;transition:border-color .25s,background .25s;-webkit-tap-highlight-color:transparent}
#kc .calc label:hover{border-color:rgba(243,238,230,.42)}
#kc .calc input{position:absolute;opacity:0;pointer-events:none}
#kc .calc label b{font:400 21px/1.1 var(--serif);color:var(--lin)}
#kc .calc label span{font-size:12.5px;line-height:1.45;color:rgba(243,238,230,.6)}
#kc .calc label svg{width:46px;height:30px;margin-bottom:4px;stroke:rgba(243,238,230,.55);fill:none;stroke-width:1.3}
#kc .calc label:has(input:checked){border-color:var(--go);background:rgba(201,169,110,.09)}
#kc .calc label:has(input:checked) svg{stroke:var(--go)}
#kc .calc label:has(input:focus-visible){outline:2px solid var(--go);outline-offset:2px}
#kc .calc label.off{opacity:.35;pointer-events:none}
#kc .calc .xt label{flex-direction:row;align-items:center;gap:10px;padding:13px 14px}
#kc .calc .xt label:before{content:"";flex:0 0 14px;height:14px;border:1px solid rgba(243,238,230,.45);transition:.2s}
#kc .calc .xt label:has(input:checked):before{background:var(--go);border-color:var(--go);box-shadow:inset 0 0 0 3px var(--g)}
#kc .calc .xt label b{font:500 13px/1.3 var(--sans);letter-spacing:.02em}
#kc .calc .res{position:sticky;top:110px;background:var(--lin);color:var(--ink);padding:clamp(28px,2.6vw,44px)}
#kc .calc .res .kick{color:var(--gd)}
#kc .calc .pr{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 14px;margin:14px 0 6px;font:300 clamp(44px,4.4vw,74px)/1 var(--serif);letter-spacing:-.01em}
#kc .calc .pr em{font-style:normal;font-size:.5em;color:var(--mut)}
#kc .calc .sum{font-size:14px;color:var(--mut);min-height:3em}
#kc .calc .bars{display:grid;gap:11px;margin:22px 0 24px;padding:22px 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
#kc .calc .bar{display:grid;grid-template-columns:118px minmax(0,1fr) 64px;align-items:center;gap:12px;font-size:12.5px}
#kc .calc .bar s{display:block;height:6px;background:var(--lin2);text-decoration:none;position:relative;overflow:hidden}
#kc .calc .bar s:after{content:"";position:absolute;inset:0 auto 0 0;width:var(--w,0%);background:var(--g2);transition:width .6s cubic-bezier(.2,.7,.2,1)}
#kc .calc .bar em{font-style:normal;text-align:right;color:var(--mut)}
#kc .calc .inc{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:6px 18px;font-size:13px;color:var(--mut);margin-bottom:24px}
#kc .calc .inc li:before{content:"";display:inline-block;width:6px;height:6px;margin-right:9px;background:var(--go);transform:rotate(45deg) translateY(-2px)}
#kc .calc .acts{display:flex;flex-wrap:wrap;gap:10px}
#kc .calc .acts .bt{background:var(--g);color:var(--lin);flex:1 1 auto}
#kc .calc .acts .bt.o{background:transparent;color:var(--ink);border:1px solid var(--hair)}
#kc .calc .fine{margin-top:18px;font-size:11.5px;line-height:1.55;color:var(--mut)}
@media (min-width:1101px){
 #kc .calc.s2{padding:30px 0 30px}
 #kc .calc.s2 h2{font-size:clamp(30px,2.5vw,44px);margin:8px 0 14px}
 #kc .calc.s2 .lead{display:none}
 #kc .calc.s2 .ai{margin-bottom:10px}
 #kc .calc.s2 .ai-in{padding:12px 16px 10px}
 #kc .calc.s2 textarea{font-size:20px;margin-top:6px;min-height:0}
 #kc .calc.s2 .ai-out{margin-top:8px}
 #kc .calc.s2 .ai-out span{padding:6px 10px;font-size:10px}
 #kc .calc.s2 .or{margin:0 0 12px}
 #kc .calc.s2 fieldset{margin-bottom:12px}
 #kc .calc.s2 legend{margin-bottom:7px}
 #kc .calc.s2 legend i{font-size:18px}
 #kc .calc.s2 label{padding:9px 12px;gap:2px}
 #kc .calc.s2 label b{font-size:17px}
 #kc .calc.s2 label span{font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
 #kc .calc.s2 label svg{width:30px;height:20px;margin:0 0 2px}
 #kc .calc.s2 .xt label{padding:10px 11px;gap:8px}
 #kc .calc.s2 .xt label b{font-size:12px}
 #kc .calc.s2 .res{top:96px;padding:26px 32px}
 #kc .calc.s2 .pr{font-size:clamp(40px,3.3vw,60px);margin:8px 0 4px}
 #kc .calc.s2 .sum{min-height:0;font-size:13.5px}
 #kc .calc.s2 .tip{margin-top:10px;padding:10px 12px}
 #kc .calc.s2 .bars{margin:14px 0 14px;padding:14px 0;gap:8px}
 #kc .calc.s2 .inc{margin-bottom:16px;gap:4px 18px}
 #kc .calc.s2 .acts .bt{height:50px}
 #kc .calc.s2 .fine{margin-top:12px;font-size:11px;line-height:1.5}
}
@media (min-width:1101px) and (max-height:860px){
 #kc .calc.s2{padding:20px 0 20px}
 #kc .calc.s2 h2{font-size:clamp(28px,2.2vw,36px);margin:6px 0 10px}
 #kc .calc.s2 .ch>div:first-child>.kick{display:none}
 #kc .calc.s2 label span,#kc .calc.s2 label svg{display:none}
 #kc .calc.s2 label{padding:9px 12px}
 #kc .calc.s2 fieldset{margin-bottom:10px}
 #kc .calc.s2 .or{margin-bottom:10px}
 #kc .calc.s2 .res{top:92px;padding:20px 26px}
 #kc .calc.s2 .res .inc{display:none}
 #kc .calc.s2 .bars{margin:10px 0 12px;padding:10px 0}
 #kc .calc.s2 .acts .bt{height:46px}
}
@media (max-width:1100px){#kc .calc .ch{grid-template-columns:1fr;gap:0}#kc .calc .ch>div:first-child,#kc .calc #kc-calc{display:contents}#kc .calc .res{position:relative;top:0;order:1;margin:6px 0 34px}#kc .calc .pk{order:2}#kc .calc.s1 .res{display:none}#kc .calc .or span{text-align:center}}
@media (max-width:760px){#kc .calc .op4,#kc .calc .op5,#kc .calc .op6{grid-template-columns:1fr 1fr}#kc .calc .op3{grid-template-columns:1fr 1fr 1fr}#kc .calc .op3 label span{display:none}#kc .calc label{padding:14px 12px}#kc .calc label b{font-size:19px}#kc .calc .inc{grid-template-columns:1fr}#kc .calc .bar{grid-template-columns:96px minmax(0,1fr) 56px}
 #kc .calc .pill{position:fixed;left:12px;right:12px;bottom:calc(66px + env(safe-area-inset-bottom));z-index:40;display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:var(--lin);color:var(--ink);box-shadow:0 10px 30px rgba(0,0,0,.28);font:500 11px/1.2 var(--sans);letter-spacing:.18em;text-transform:uppercase;opacity:0;transform:translateY(12px);pointer-events:none;transition:.35s}
 #kc .calc .pill b{font:400 22px/1 var(--serif);letter-spacing:0;text-transform:none}
 #kc .calc.s2.vis .pill{opacity:1;transform:none;pointer-events:auto}}
@media (min-width:761px){#kc .calc .pill{display:none}}
</style>